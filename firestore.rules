rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isVendor(vendorId) {
      return signedIn() && request.auth.uid == vendorId;
    }

    function isVendorProductOwner() {
      return signedIn() &&
        resource.data.vendorId == request.auth.uid;
    }

    function isIncomingVendorProductOwner() {
      return signedIn() &&
        request.resource.data.vendorId == request.auth.uid;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function orderData(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    function isOrderVendor(orderId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/orders/$(orderId)) &&
        orderData(orderId).vendorId == request.auth.uid;
    }

    function isValidCommissionType(type) {
      return type == "customer" || type == "vendor";
    }

    match /admins/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /referral_profiles/{referralCode} {
      allow read: if true;
      allow create, update: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || isOwner(userId)
        || resource.data.referredBy == request.auth.uid;
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if isAdmin() || isVendor(vendorId) || resource.data.referredBy == request.auth.uid;
      allow create: if isAdmin() || isVendor(vendorId);
      allow update: if isAdmin() || isVendor(vendorId);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() || isIncomingVendorProductOwner();
      allow update, delete: if isAdmin() || isVendorProductOwner();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin() || isOwner(resource.data.userId);
      }
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.customerId == request.auth.uid;
      allow read: if isAdmin()
        || isOwner(resource.data.userId)
        || isVendor(resource.data.vendorId);
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.vendorId == request.auth.uid
          && request.resource.data.vendorId == resource.data.vendorId
          && request.resource.data.userId == resource.data.userId
          && (
            request.resource.data.customerId == resource.data.customerId
            || (
              !("customerId" in resource.data)
              && request.resource.data.customerId == resource.data.userId
            )
          )
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "status",
            "updatedAt"
          ])
        );
      allow delete: if isAdmin();
    }

    match /commissions/{commissionId} {
      allow read: if isAdmin() || signedIn() && resource.data.referrerId == request.auth.uid;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /vendor_payouts/{payoutId} {
      allow read: if isAdmin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /platform_settings/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
